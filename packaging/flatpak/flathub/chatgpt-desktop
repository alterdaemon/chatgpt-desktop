#!/usr/bin/env sh
set -eu

export TMPDIR="${XDG_RUNTIME_DIR}/app/${FLATPAK_ID}"

APP_ROOT="/app/lib/io.github.alterdaemon.chatgpt-desktop"
ELECTRON_BIN="/app/lib/electron/electron"

if [ ! -x "${ELECTRON_BIN}" ]; then
  printf 'Unable to locate the packaged Electron runtime.\n' >&2
  exit 1
fi

exec zypak-wrapper "${ELECTRON_BIN}" "${APP_ROOT}" "$@"
