#!/usr/bin/env sh
set -eu

export TMPDIR="${XDG_RUNTIME_DIR}/app/${FLATPAK_ID}"

APP_ROOT="/app/lib/io.github.alterdaemon.chatgpt-desktop"
APP_BIN="${APP_ROOT}/chatgpt-desktop"

if [ "${XDG_SESSION_TYPE:-}" = "wayland" ]; then
  exec zypak-wrapper "${APP_BIN}" --ozone-platform=wayland "$@"
fi

exec zypak-wrapper "${APP_BIN}" "$@"
