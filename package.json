{
  "name": "chatgpt-desktop",
  "version": "1.8.0",
  "description": "Minimal Electron wrapper for ChatGPT with optional customization, optimized for Linux",
  "homepage": "https://chatgpt.com",
  "main": "main.js",
  "desktopName": "io.github.alterdaemon.chatgpt-desktop.desktop",
  "author": {
    "name": "alter.daemon",
    "email": "alter.daemon.ivytq@passmail.com"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:linux:dir": "electron-builder --linux dir --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "setup:flatpak": "./packaging/flatpak/release/setup-flatpak.sh",
    "build:flatpak:release": "./packaging/flatpak/release/build-flatpak.sh",
    "build:flatpak:flathub": "./packaging/flatpak/flathub/build-flatpak.sh",
    "build:flatpak": "npm run build:flatpak:release",
    "validate:flatpak:release": "./packaging/flatpak/release/validate-flatpak-assets.sh",
    "validate:flatpak:flathub": "./packaging/flatpak/flathub/validate-flatpak-assets.sh",
    "validate:flatpak-assets": "npm run validate:flatpak:release",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "xvfb-run -a npx playwright test --project=integration",
    "test:live": "xvfb-run -a npx playwright test --project=live",
    "test": "npm run test:unit && npm run test:integration && npm run test:live",
    "release:linux": "npm run build:linux",
    "release:flatpak": "npm run build:flatpak:release"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "io.github.alterdaemon.chatgpt-desktop",
    "productName": "ChatGPT Desktop (Unofficial)",
    "npmRebuild": false,
    "files": [
      "main.js",
      "app-logic.js",
      "preload.js",
      "page-modules/vimium-navigation.js",
      "package.json",
      "build/icons/icon.png"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "${name}_${version}_${arch}.${ext}",
      "icon": "build/icons",
      "executableName": "chatgpt-desktop",
      "maintainer": "alter.daemon <alter.daemon.ivytq@passmail.com>",
      "category": "Utility"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false,
      "enableCookieEncryption": true
    }
  }
}
